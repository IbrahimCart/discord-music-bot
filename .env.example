# Copy this file to ".env" and fill it in. NEVER commit ".env" or share these values.

# Required: Discord Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Recommended: your server's ID (right-click the server with Developer Mode on -> Copy Server ID).
# Makes slash commands show up instantly instead of after a delay.
GUILD_ID=

# Optional, only for Spotify links: developer.spotify.com/dashboard -> Create app
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=

# Optional: cookies.txt exported from your browser, if YouTube says "confirm you're not a bot"
COOKIES_FILE=

# Optional: max tracks to queue from one Spotify playlist/album
MAX_PLAYLIST=100
